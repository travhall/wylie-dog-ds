{
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
  },
  "radius": {
    "md": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
  },
  "time": {
    "fast": { "$type": "duration", "$value": { "value": 150, "unit": "ms" } }
  },
  "ease": {
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "opacity": {
    "disabled": { "$type": "number", "$value": 0.6 }
  },
  "font": {
    "body": { "$type": "fontFamily", "$value": "Inter" },
    "weight": {
      "bold": { "$type": "number", "$value": 700 }
    }
  }
}
