{
  "name": "figma-plugin",
  "version": "0.2.0",
  "private": true,
  "description": "Design token synchronization between Figma and code repositories",
  "type": "module",
  "main": "dist/plugin.js",
  "scripts": {
    "build": "pnpm run build:plugin && pnpm run build:ui",
    "build:plugin": "vite build",
    "build:ui": "vite build --mode ui",
    "build:watch": "concurrently \"vite build --watch\" \"vite build --watch --mode ui\"",
    "clean": "rm -rf dist node_modules .turbo",
    "clean:dist": "rm -rf dist",
    "dev": "pnpm run clean:dist && pnpm run build && pnpm run build:watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@wyliedog/tokens": "workspace:*",
    "cross-fetch": "^4.1.0",
    "culori": "^4.0.2",
    "jszip": "^3.10.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.135.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "catalog:",
    "jsdom": "^30.0.1",
    "terser": "^5.50.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.68.0",
    "vite": "catalog:",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "catalog:"
  }
}
