{
  "name": "figma-plugin",
  "version": "0.2.0",
  "private": true,
  "description": "Design token synchronization between Figma and code repositories",
  "type": "module",
  "main": "dist/plugin.js",
  "scripts": {
    "build": "pnpm run build:plugin && pnpm run build:ui",
    "build:plugin": "vite build",
    "build:ui": "vite build --mode ui",
    "build:watch": "concurrently \"vite build --watch\" \"vite build --watch --mode ui\"",
    "clean": "rm -rf dist node_modules .turbo",
    "clean:dist": "rm -rf dist",
    "dev": "pnpm run clean:dist && pnpm run build && pnpm run build:watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@wyliedog/tokens": "workspace:*",
    "cross-fetch": "^4.1.0",
    "culori": "^4.0.2",
    "jszip": "^3.10.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.141.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "concurrently": "^10.0.6",
    "eslint": "catalog:",
    "jsdom": "^30.1.2",
    "terser": "^5.51.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2",
    "vite": "catalog:",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "catalog:"
  }
}
