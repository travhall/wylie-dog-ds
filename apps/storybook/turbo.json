{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "inputs": [
        "stories/**/*.{ts,tsx}",
        ".storybook/**",
        "eslint.config.js",
        "package.json"
      ],
      "cache": true
    },
    "test": {
      "inputs": ["stories/**/*.stories.tsx", ".storybook/**", "vite.config.ts"],
      "cache": true
    },
    "test:a11y": {
      "inputs": ["stories/**/*.stories.tsx", ".storybook/**", "vite.config.ts"],
      "cache": true
    },
    "test:coverage": {
      "inputs": ["stories/**/*.stories.tsx", ".storybook/**", "vite.config.ts"],
      "outputs": ["coverage/**"],
      "cache": true
    }
  }
}
