{
  "tokenAllow": {
    "apps/figma-plugin/CONTRIBUTING.md": [
      "^--(space-3|text-primary|radius-md)$"
    ],
    "apps/figma-plugin/README.md": ["^--text-primary$"],
    "apps/storybook/stories/Contributing/Guidelines/code-standards.mdx": [
      "-component-"
    ],
    "apps/storybook/stories/Contributing/Workflows/component-development.mdx": [
      "-component-"
    ],
    "apps/storybook/stories/Resources/Theming/overview.mdx": [
      "^--color-brand",
      "^--text-on-light$"
    ],
    "documentation/STYLING_ARCHITECTURE.md": ["^--color-new-token$"],
    "packages/tokens/COVERAGE.md": [
      "^--(duration-duration-200|color-border-strong|color-destructive|color-warning|shadow-xs|color-violet-500|color-button-primary-bg)$"
    ],
    "documentation/guides/component-workflow.md": ["^--color-my-component-"]
  },
  "vocabulary": {
    "checkDescriptions": true,
    "allow": [
      "documentation/tokens/semantic-pairing-model.md",
      "documentation/tokens/semantic-token-mapping.md",
      "documentation/archive/",
      "documentation/case-studies/",
      "apps/figma-plugin/docs/ACCESSIBILITY_AUDIT.md",
      "apps/figma-plugin/docs/ACCESSIBILITY.md"
    ],
    "phrases": [
      {
        "pattern": "\\btertiary (text|background|border|color)",
        "reason": "old tone name; see naming-convention.md"
      },
      {
        "pattern": "\\bsecondary (text|background|border) (color|token)",
        "reason": "old tone name; see naming-convention.md"
      },
      {
        "pattern": "\\bon-solid\\b",
        "reason": "split into per-role foregrounds"
      },
      {
        "pattern": "\\binteractive (token set|primary|color)\\b",
        "reason": "the interactive namespace was retired"
      },
      {
        "pattern": "\\bsurface (token|color)s?\\b",
        "reason": "surface became background"
      },
      {
        "pattern": "WCAG 2\\.1\\b",
        "reason": "the project target is WCAG 2.2"
      }
    ]
  }
}
