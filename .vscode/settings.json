{
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "files.watcherExclude": {
    "**/.claude/worktrees/**": true,
    "**/node_modules/**": true
  },
  "files.exclude": {
    "**/.claude/worktrees": true
  },
