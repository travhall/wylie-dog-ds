{
  "name": "design-system",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check:docs": "node scripts/check-docs.mjs",
    "check:docs:coverage": "pnpm --filter @wyliedog/ui exec vitest run --coverage && node scripts/check-docs.mjs --require-coverage",
    "check:tokens": "node scripts/check-token-refs.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo run dev",
    "dev:figma": "turbo run dev --filter=figma-plugin",
    "dev:showcase": "turbo run dev --filter=showcase",
    "dev:storybook": "turbo run dev --filter=storybook",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "generate:component": "node scripts/generate-component.js",
    "lint": "turbo run lint",
    "lint:a11y": "turbo run lint:a11y",
    "perf": "./scripts/performance-check.sh",
    "prepare": "husky",
    "preview-storybook": "turbo run preview-storybook",
    "size": "size-limit",
    "test": "turbo run test",
    "test:a11y": "turbo run test:a11y",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.1.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "size-limit": "^13.1.1",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  }
}
